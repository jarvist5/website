{
  "name": "leafivo-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test test/*.test.js",
    "test:e2e": "playwright test",
    "deploy:render": "node --use-env-proxy scripts/deploy-render.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stripe": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@sparticuz/chromium": "^153.0.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "vite": "^7.2.2"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
