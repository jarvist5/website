# Copy this file to .env for local development. Never commit .env or real keys.
NODE_ENV=development
STORE_NAME=Leafivo
PORT=3001
STORE_MODE=preview
# Public inspection only: true disables owner APIs, email signup and order persistence.
PUBLIC_PREVIEW=false
PUBLIC_BASE_URL=http://localhost:5173

# Required to open the private store-management API. Use at least 24 random characters.
ADMIN_TOKEN=

# Keep empty in preview mode. Use Stripe test credentials before live credentials.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional persistent paths. Defaults shown; relative paths use server process cwd.
# Keep both outside the public web root and back them up securely.
DATABASE_PATH=.data/store.sqlite
DOWNLOAD_DIR=private-downloads

# Optional: set only for a known trusted reverse-proxy topology (1–3 hops).
# TRUST_PROXY_HOPS=1
