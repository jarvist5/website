# Copy this file to .env for local development. Never commit .env or real keys.
NODE_ENV=development
STORE_NAME=Leafivo
PORT=3001
STORE_MODE=preview
# Public inspection only: disables signup/order persistence; owner access separately gated.
PUBLIC_PREVIEW=false
PUBLIC_BASE_URL=http://localhost:5173

# Legacy local development only; production requires the secure owner login below.
ADMIN_TOKEN=

# Keep empty in preview mode. Use Stripe test credentials before live credentials.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional persistent paths. Defaults shown; relative paths use server process cwd.
# Keep both outside the public web root and back them up securely.
DATABASE_PATH=.data/store.sqlite
DOWNLOAD_DIR=private-downloads

# Optional: set only for a known trusted reverse-proxy topology (1–3 hops).
# TRUST_PROXY_HOPS=1

# Secure owner access: keep disabled on free/temporary hosting.
OWNER_MANAGEMENT_ENABLED=false
OWNER_STORAGE_PERSISTENT=false
# Private stable key encrypts authenticator secrets; back it up securely.
OWNER_AUTH_KEY=
# One-use bootstrap token and ISO8601 expiry; remove once the owner is enrolled.
OWNER_SETUP_TOKEN=
OWNER_SETUP_EXPIRES=
# Separate stable key signs paid downloads (never use an owner password).
DOWNLOAD_SIGNING_KEY=
